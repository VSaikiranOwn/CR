{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/cr_spec.schema.json",
  "title": "CR Estimation Framework spec (ver. 2)",
  "description": "The only per-CR input. Copilot writes this from the Figma screens, Jira user stories, HLD and LLD; cr-tool renders it into the fixed company workbook.",
  "type": "object",
  "required": ["rows"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "description": "Free-form provenance. Not written into the workbook.",
      "additionalProperties": true
    },
    "stories": {
      "type": "array",
      "description": "One entry per Jira user story. Becomes one row on the 'Tender Story Points' sheet.",
      "items": { "$ref": "#/$defs/story" }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "description": "One entry per AC group. Becomes one row on the 'Details' sheet.",
      "items": { "$ref": "#/$defs/detailRow" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "original_efforts": {
          "type": "object",
          "description": "Optional prior estimate, shown in the Summary 'Original Efforts' column for comparison.",
          "additionalProperties": false,
          "properties": {
            "development": { "type": "number" },
            "qa": { "type": "number" },
            "req_design": { "type": "number" }
          }
        }
      }
    }
  },
  "$defs": {
    "scopeSize": {
      "description": "Scope Assessment size. Shorthand S / M / L / NA is accepted and normalised.",
      "enum": ["Not Applicable", "Small (1-3)", "Medium (4-6)", "Large (>6)",
               "NA", "S", "M", "L", "small", "medium", "large"]
    },
    "reuseLevel": {
      "description": "Reusability Assessment level. Shorthand 0 / 1 / 2 / 4 / NA is accepted and normalised.",
      "enum": ["Not Applicable", "0 - No Reusability", "1 - Low Reusability",
               "2 - Moderate Reusability", "4 - High Reusability",
               "NA", "0", "1", "2", "4", "no", "low", "moderate", "high"]
    },
    "scopeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size"],
      "properties": {
        "size": { "$ref": "#/$defs/scopeSize" },
        "details": { "type": "string", "description": "Evidence for the size: the actual interactions / pages / integrations counted." }
      }
    },
    "reuseEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "$ref": "#/$defs/reuseLevel" },
        "details": { "type": "string", "description": "What can be reused and what must be built." }
      }
    },
    "story": {
      "type": "object",
      "required": ["us_id", "scope", "reusability"],
      "additionalProperties": false,
      "properties": {
        "epic": { "type": "string" },
        "us_id": { "type": "string", "description": "Jira key, e.g. SLADCYBQSK-42132." },
        "us_summary": { "type": "string" },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "user_interaction": { "$ref": "#/$defs/scopeEntry" },
            "pages": { "$ref": "#/$defs/scopeEntry" },
            "integration": { "$ref": "#/$defs/scopeEntry" }
          }
        },
        "reusability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "frontend": { "$ref": "#/$defs/reuseEntry" },
            "backend": { "$ref": "#/$defs/reuseEntry" },
            "interface": { "$ref": "#/$defs/reuseEntry" },
            "database": { "$ref": "#/$defs/reuseEntry" },
            "qa": { "$ref": "#/$defs/reuseEntry" }
          }
        }
      }
    },
    "complexityCounts": {
      "type": "array",
      "description": "[simple, medium, complex] flag counts. Usually a single 1.",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "integer", "minimum": 0 }
    },
    "detailRow": {
      "type": "object",
      "required": ["user_story", "business_requirement", "technical_component"],
      "additionalProperties": false,
      "properties": {
        "user_story": { "type": "string", "description": "Jira key, or 'Shared' for cross-cutting work." },
        "group": { "type": "string", "description": "Story group this row belongs to. Only needed to attach a 'Shared' row to a specific story, or to start a new group." },
        "s_no": { "type": "integer", "minimum": 1, "description": "Optional. Auto-numbered per group when omitted." },
        "business_requirement": { "type": "string", "description": "Column C: the AC(s) this row covers, in prose." },
        "technical_component": { "type": "string", "description": "Column D: the technical analysis. Newline-separated, grouped by dimension, labelling NEW vs EXISTING APIs." },
        "ui": { "$ref": "#/$defs/complexityCounts" },
        "ms": { "$ref": "#/$defs/complexityCounts" },
        "db": { "$ref": "#/$defs/complexityCounts" },
        "bpm": { "$ref": "#/$defs/complexityCounts" }
      }
    }
  }
}
